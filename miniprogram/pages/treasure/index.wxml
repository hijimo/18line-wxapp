<view class="page-container">
  <!-- Header -->
  <navigation-bar title="集市" back="{{false}}" color="black" background="#F9FAF4"></navigation-bar>

  <!-- Category Tabs -->
  <view class="tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="id"
      class="tab {{activeType === item.id ? 'tab--active' : ''}}"
      data-type="{{item.id}}"
      bindtap="onTabTap"
    >
      <text class="tab-text">{{item.label}}</text>
    </view>
  </view>

  <!-- List Content -->
  <scroll-view class="scrollarea" scroll-y type="list">
    <!-- Loading -->
    <view wx:if="{{loading}}" class="list-loading">
      <text class="loading-text">加载中...</text>
    </view>

    <!-- Service List -->
    <view wx:if="{{!loading}}" class="service-list">
      <!-- Hotel -->
      <block wx:if="{{activeType === 'hotel'}}">
        <view
          wx:for="{{list}}"
          wx:key="accommodationId"
          class="service-item"
          data-item="{{item}}"
          bindtap="onItemTap"
        >
          <image
            wx:if="{{item.attachments && item.attachments.length > 0}}"
            class="item-image"
            src="{{item.attachments[0].url}}"
            mode="aspectFill"
            lazy-load
          />
          <view class="item-info">
            <text class="item-name">{{item.accommodationName}}</text>
            <text class="item-desc">{{item.accommodationDesc}}</text>
            <view class="item-meta">
              <text wx:if="{{item.accommodationType}}" class="meta-tag">{{item.accommodationType}}</text>
              <text wx:if="{{item.priceMin}}" class="meta-price">¥{{item.priceMin}}~{{item.priceMax}}</text>
            </view>
          </view>
        </view>
      </block>

      <!-- Dining -->
      <block wx:if="{{activeType === 'dining'}}">
        <view
          wx:for="{{list}}"
          wx:key="diningId"
          class="service-item"
          data-item="{{item}}"
          bindtap="onItemTap"
        >
          <image
            wx:if="{{item.attachments && item.attachments.length > 0}}"
            class="item-image"
            src="{{item.attachments[0].url}}"
            mode="aspectFill"
            lazy-load
          />
          <view class="item-info">
            <text class="item-name">{{item.diningName}}</text>
            <text class="item-desc">{{item.diningDesc}}</text>
            <view class="item-meta">
              <text wx:if="{{item.avgCost}}" class="meta-price">人均 ¥{{item.avgCost}}</text>
            </view>
          </view>
        </view>
      </block>

      <!-- Car -->
      <block wx:if="{{activeType === 'car'}}">
        <view
          wx:for="{{list}}"
          wx:key="carId"
          class="service-item"
          data-item="{{item}}"
          bindtap="onItemTap"
        >
          <image
            wx:if="{{item.attachments && item.attachments.length > 0}}"
            class="item-image"
            src="{{item.attachments[0].url}}"
            mode="aspectFill"
            lazy-load
          />
          <view class="item-info">
            <text class="item-name">{{item.nickname}}</text>
            <text class="item-desc">{{item.carModel}} · {{item.seatCount}}座 · {{item.drivingYears}}年驾龄</text>
            <view class="item-meta">
              <text wx:if="{{item.price}}" class="meta-price">¥{{item.price}}/天</text>
            </view>
          </view>
        </view>
      </block>

      <!-- Photography -->
      <block wx:if="{{activeType === 'photography'}}">
        <view
          wx:for="{{list}}"
          wx:key="photographyId"
          class="service-item"
          data-item="{{item}}"
          bindtap="onItemTap"
        >
          <image
            wx:if="{{item.attachments && item.attachments.length > 0}}"
            class="item-image"
            src="{{item.attachments[0].url}}"
            mode="aspectFill"
            lazy-load
          />
          <view class="item-info">
            <text class="item-name">{{item.nickname}}</text>
            <text class="item-desc">{{item.introduction}}</text>
            <view class="item-meta">
              <text wx:if="{{item.equipment}}" class="meta-tag">{{item.equipment}}</text>
              <text wx:if="{{item.price}}" class="meta-price">¥{{item.price}}</text>
            </view>
          </view>
        </view>
      </block>

      <!-- Empty State -->
      <view wx:if="{{!loading && list.length === 0}}" class="empty-state">
        <text class="empty-title">暂无数据</text>
        <text class="empty-desc">该类别暂无服务，请稍后再试</text>
      </view>
    </view>
  </scroll-view>

  <!-- Intro Drawers -->
  <hotel-intro-drawer
    wx:if="{{showIntroType === 'hotel'}}"
    show="{{true}}"
    data="{{introData}}"
    source="schedule"
    bind:close="onIntroClose"
  />
  <car-intro-drawer
    wx:if="{{showIntroType === 'car'}}"
    show="{{true}}"
    data="{{introData}}"
    source="schedule"
    bind:close="onIntroClose"
  />
  <photography-intro-drawer
    wx:if="{{showIntroType === 'photography'}}"
    show="{{true}}"
    data="{{introData}}"
    source="schedule"
    bind:close="onIntroClose"
  />
  <dining-intro-drawer
    wx:if="{{showIntroType === 'dining'}}"
    show="{{true}}"
    data="{{introData}}"
    source="schedule"
    bind:close="onIntroClose"
  />
</view>
